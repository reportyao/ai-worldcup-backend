// AI Worldcup Prediction Platform - Phase 1 Schema
// T1-01: Competition, Team, Match
// T1-02: AiModel, PredictionTask, ModelPrediction
// T1-03: User, Guest, Invitation, Entitlement, Order

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Locale {
  zh_CN
  en
}

enum CompetitionType {
  WORLD_CUP
  CONTINENTAL_CUP
  CITY_LEAGUE
  OTHER
}

enum CompetitionPriority {
  P0
  P1
  P2
  P3
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELED
}

enum UserPredictionResult {
  HOME_WIN
  DRAW
  AWAY_WIN
}

enum PredictionVersion {
  T_MINUS_24H
  T_MINUS_2H
}

enum PredictionTaskStatus {
  PENDING
  RUNNING
  PARTIAL_SUCCESS
  SUCCEEDED
  FAILED
  REVIEWED
  PUBLISHED
}

enum PredictionTrigger {
  CRON
  MANUAL
}

enum PromptTemplateStatus {
  ACTIVE
  INACTIVE
}

enum ConsensusLevel {
  HIGH
  MIXED
  STRONG_DIVERGENCE
}

enum ModelPersona {
  STEADY
  ATTACKING
  UPSET_HUNTER
  DATA_DRIVEN
}

enum EntitlementSource {
  FREE_DAILY
  INVITE_REWARD
  PASS_SUBSCRIPTION
  ADMIN_GRANT
}

enum EntitlementStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum PaymentChannel {
  WECHAT_PAY
  STRIPE
}

enum OrderStatus {
  CREATED
  PAID
  CANCELED
  REFUNDED
  FAILED
}

enum PassTier {
  TIER_1
  TIER_2
  TIER_3
}

enum PersonalityQuestionType {
  SINGLE_CHOICE
}

enum PersonalityResultEventType {
  VIEW_RESULT
  CHANGE_SUBTITLE
  CHANGE_SKIN
  SAVE_IMAGE
  SHARE_CLICK
  CTA_CLICK
  FRIEND_VOTE
}

enum AiPkPick {
  HOME_WIN
  DRAW
  AWAY_WIN
}

enum AiPkSettlementStatus {
  PENDING
  USER_HIT_AI_MISS
  USER_MISS_AI_HIT
  BOTH_HIT
  BOTH_MISS
  VOID
}

enum AiPkEventType {
  SAVE_IMAGE
  SHARE_CLICK
  CHANGE_REASON
  CTA_CLICK
}

// ─────────────────────────────────────────────────────────────────────────────
// T1-01: Competition / Team / Match
// ─────────────────────────────────────────────────────────────────────────────

/// 赛事（世界杯、洲际杯、联赛等）
model Competition {
  id         String              @id @default(cuid())
  /// 唯一标识码，如 "WC-2026", "EURO-2024"
  code       String              @unique
  name       String
  type       CompetitionType     @default(WORLD_CUP)
  /// 联赛优先级：P0=核心赛事 P1=用户常看 P2=次级 P3=低级别
  priority   CompetitionPriority @default(P2)
  /// 赛季标识，如 "2026", "2024-25"
  season     String
  /// 赛事所属国家/地区，用于后台筛选与运营展示
  country    String?
  /// 城市场景标签，如 "New York", "Shanghai"，用于本地化运营
  cityTag    String?
  /// 后台上下架状态：ACTIVE / DRAFT / ARCHIVED
  status     String              @default("ACTIVE")
  startDate  DateTime?
  endDate    DateTime?
  /// 外部数据源 ID（如 football-data.org 的 competition id）
  externalId String?             @unique
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  matches Match[]

  @@index([type, season])
  @@index([status, startDate])
  @@index([priority, status])
}

/// 球队
model Team {
  id          String   @id @default(cuid())
  /// 唯一标识码，如 "BRA", "GER", "JPN"
  code        String   @unique
  /// 球队全名（英文）
  name        String
  /// 球队简称（用于 UI 展示）
  shortName   String?
  /// 国旗 emoji 或 ISO 3166-1 alpha-2 国家代码
  countryCode String?
  /// 球队徽章 URL
  crestUrl    String?
  /// 外部数据源 ID
  externalId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")

  @@index([code])
}

/// 比赛
model Match {
  id            String      @id @default(cuid())
  /// 所属赛事
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  /// 主队
  homeTeamId    String
  homeTeam      Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  /// 客队
  awayTeamId    String
  awayTeam      Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  /// 开球时间 (UTC)
  kickoffAt     DateTime
  /// 比赛状态
  status        MatchStatus @default(SCHEDULED)
  /// 比赛日（用于按天查询，格式 "2026-06-14"）
  matchday      String?
  /// 小组/轮次信息，如 "Group A", "Round of 16"
  stage         String?
  /// 主队进球数（比赛结束后填充）
  homeScore     Int?
  /// 客队进球数（比赛结束后填充）
  awayScore     Int?
  /// 外部数据源 ID
  externalId    String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  predictionTasks PredictionTask[]
  userPredictions UserPrediction[]
  modelReviews    ModelReview[]
  shareTracks     ShareTrack[]
  unlocks         MatchUnlock[]
  matchFeatures   MatchFeature[]
  aiPkRecords     AiPkRecord[]

  @@unique([competitionId, homeTeamId, awayTeamId, kickoffAt])
  @@index([competitionId, kickoffAt])
  @@index([status, kickoffAt])
  @@index([matchday])
}

/// 第三方足球数据同步运行日志（API-Football 等）
model FootballDataSyncLog {
  id           String    @id @default(cuid())
  provider     String    @default("api-football")
  scope        String
  status       String    @default("RUNNING")
  params       Json?
  summary      Json?
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([provider, scope, startedAt])
  @@index([status, startedAt])
}

/// 原始 API 响应存档（用于重算和排查）
model RawApiResponse {
  id         String   @id @default(cuid())
  /// 数据提供方，如 "api-football"
  provider   String   @default("api-football")
  /// 端点标识，如 "get_events", "get_teams"
  endpoint   String
  /// 关联的外部 ID（如 match external id）
  externalId String?
  /// 原始 JSON 响应
  rawJson    Json
  /// 请求参数快照
  params     Json?
  createdAt  DateTime @default(now())

  @@index([provider, endpoint, externalId])
  @@index([createdAt])
}

/// 比赛级特征快照（预测输入的数据基础）
model MatchFeature {
  id             String   @id @default(cuid())
  /// 关联比赛
  matchId        String
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  /// 特征计算版本，如 "v1.0"
  featureVersion String   @default("v1.0")
  /// 结构化特征 JSON（近期状态、攻防、主客场、赛程等）
  featuresJson   Json
  /// 压缩后的文本摘要（直接拼入 Prompt）
  summaryText    String?
  /// 数据完整度等级：HIGH / MEDIUM / LOW
  dataQuality    String   @default("MEDIUM")
  /// 缺失的数据信号
  missingSignals Json?    @default("[]")
  /// 计算时间
  computedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([matchId, featureVersion])
  @@index([matchId, computedAt])
  @@index([featureVersion, computedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// T1-02: AiModel / PredictionTask / ModelPrediction
// ─────────────────────────────────────────────────────────────────────────────

/// AI 模型注册表
model AiModel {
  id          String       @id @default(cuid())
  /// 模型唯一标识，如 "gpt-4.1-mini", "gemini-2.5-flash"
  modelId     String       @unique
  /// 面向用户的展示名称
  displayName String
  /// 模型人设/风格
  persona     ModelPersona @default(STEADY)
  /// 模型提供商，如 "openai", "google", "anthropic"
  provider    String
  /// 是否启用（可动态开关模型）
  isActive    Boolean      @default(true)
  /// 后台排序值，数值越小越优先调用
  sortOrder   Int          @default(100)
  /// 模型描述
  description String?
  /// 模型配置 JSON（temperature, maxTokens 等）
  config      Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  predictions ModelPrediction[]
  reviews     ModelReview[]
  scorecards  ModelScorecard[]

  @@index([isActive, sortOrder])
  @@index([isActive, persona])
}

/// 预测任务（一场比赛的一个时间版本对应一个 Task）
model PredictionTask {
  id                String               @id @default(cuid())
  /// 关联比赛
  matchId           String
  match             Match                @relation(fields: [matchId], references: [id])
  /// 预测版本：T-24h 或 T-2h
  version           PredictionVersion
  /// 任务状态
  status            PredictionTaskStatus @default(PENDING)
  /// 触发方式
  trigger           PredictionTrigger    @default(CRON)
  /// 参与本次预测的模型数量
  modelCount        Int                  @default(0)
  /// 成功完成的模型数量
  successCount      Int                  @default(0)
  /// 失败的模型数量
  failureCount      Int                  @default(0)
  /// 共识等级（所有模型预测完成后计算）
  consensusLevel    ConsensusLevel?
  /// 共识摘要 JSON
  consensusSummary  Json?
  /// 发布时间（REVIEWED -> PUBLISHED 时设置）
  publishedAt       DateTime?
  /// 任务错误信息
  errorMessage      String?
  /// 本次预测使用的特征快照 ID（用于回测追溯）
  featureSnapshotId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  predictions  ModelPrediction[]
  modelReviews ModelReview[]
  aiPkRecords  AiPkRecord[]

  /// 同一场比赛同一版本只能有一个任务
  @@unique([matchId, version])
  @@index([status, createdAt])
  @@index([matchId, version, status])
}

/// 单个模型对单场比赛的预测结果
model ModelPrediction {
  id               String         @id @default(cuid())
  /// 关联预测任务
  predictionTaskId String
  predictionTask   PredictionTask @relation(fields: [predictionTaskId], references: [id], onDelete: Cascade)
  /// 关联 AI 模型
  aiModelId        String
  aiModel          AiModel        @relation(fields: [aiModelId], references: [id])
  /// 结构化预测输出 JSON（符合 StructuredPredictionSchema）
  structuredOutput Json
  /// AI 原始输出文本（用于调试和审计）
  rawOutput        String?
  /// 使用的 Prompt 模板版本
  promptVersion    String?
  /// 使用的 Prompt 完整内容快照
  promptSnapshot   String?
  /// 模型调用耗时（毫秒）
  latencyMs        Int?
  /// 输入 token 数
  inputTokens      Int?
  /// 输出 token 数
  outputTokens     Int?
  /// 是否成功
  isSuccess        Boolean        @default(true)
  /// 错误信息（如果失败）
  errorMessage     String?
  /// 生成时间
  generatedAt      DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  /// 同一任务中同一模型只能有一条预测
  @@unique([predictionTaskId, aiModelId])
  @@index([predictionTaskId, isSuccess])
  @@index([aiModelId, generatedAt])
}

/// 后台可配置的 AI 提示词模板。默认用于 MATCH_PREDICTION，可按版本保留历史快照。
model PromptTemplate {
  id           String               @id @default(cuid())
  scene        String               @default("MATCH_PREDICTION")
  name         String
  version      String
  status       PromptTemplateStatus @default(ACTIVE)
  systemPrompt String
  userPrompt   String
  description  String?
  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([scene, version])
  @@index([scene, status, updatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// T1-03: User / Guest / Invitation / Entitlement / Order
// ─────────────────────────────────────────────────────────────────────────────

/// 注册用户（通过微信/第三方登录后创建）
model User {
  id            String    @id @default(cuid())
  /// 微信小程序登录后填充
  wechatOpenId  String?   @unique
  unionId       String?   @unique
  nickname      String?
  avatarUrl     String?
  locale        Locale    @default(zh_CN)
  /// 用户时区，如 "Asia/Shanghai"
  timezone      String    @default("UTC")
  /// 是否为付费会员
  isPassActive  Boolean   @default(false)
  /// 会员到期时间
  passExpiresAt DateTime?
  /// 会员等级
  passTier      PassTier?
  /// 从哪个游客升级而来
  guestId       String?   @unique
  guest         Guest?    @relation(fields: [guestId], references: [id])
  /// 用户固定邀请码（全局唯一，首次自动生成，不可更改）
  inviteCode    String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entitlements        Entitlement[]
  matchUnlocks        MatchUnlock[]
  orders              Order[]
  sentInvitations     Invitation[]            @relation("Inviter")
  receivedInvitation  Invitation?             @relation("Invitee")
  userPredictions     UserPrediction[]
  shareTracks         ShareTrack[]
  shareAttributions   ShareAttribution[]      @relation("AttributedUser")
  inviterAttributions ShareAttribution[]      @relation("Inviter_Attribution")
  personalityResults  PersonalityTestResult[]
  aiPkRecords         AiPkRecord[]

  @@index([isPassActive])
  @@index([createdAt])
}

/// 游客（未登录用户，通过设备指纹标识）
model Guest {
  id            String   @id @default(cuid())
  /// 设备指纹（浏览器 fingerprint）
  fingerprint   String   @unique
  /// 用户代理
  userAgent     String?
  /// IP 地址（首次访问时记录）
  ipAddress     String?
  /// 语言偏好
  locale        Locale   @default(en)
  /// 今日已使用的免费次数
  freeUsedToday Int      @default(0)
  /// 今日免费次数重置日期（格式 "2026-06-14"）
  freeResetDate String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// 游客升级为注册用户后的关联
  user               User?
  entitlements       Entitlement[]
  matchUnlocks       MatchUnlock[]
  userPredictions    UserPrediction[]
  shareTracks        ShareTrack[]
  personalityResults PersonalityTestResult[]
  aiPkRecords        AiPkRecord[]

  @@index([fingerprint])
  @@index([createdAt])
}

/// 用户或游客对单场比赛提交的预测。游客登录后会合并到用户维度，保留原提交时间用于战绩统计。
model UserPrediction {
  id              String               @id @default(cuid())
  matchId         String
  match           Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?                @relation(fields: [userId], references: [id])
  guestId         String?
  guest           Guest?               @relation(fields: [guestId], references: [id])
  prediction      UserPredictionResult
  homeScore       Int
  awayScore       Int
  goalsMin        Int?
  goalsMax        Int?
  clientRequestId String?
  ipAddress       String?
  userAgent       String?
  submittedAt     DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([matchId, userId])
  @@unique([matchId, guestId])
  @@index([matchId, submittedAt])
  @@index([userId, submittedAt])
  @@index([guestId, submittedAt])
}

/// 邀请记录（固定码多次使用模式：每次被邀请人使用固定码，创建一条新记录）
model Invitation {
  id            String           @id @default(cuid())
  /// 邀请人
  inviterId     String
  inviter       User             @relation("Inviter", fields: [inviterId], references: [id])
  /// 邀请人的固定邀请码快照（冗余存储，便于查询）
  code          String
  /// 被邀请人（每条记录对应一个被邀请人，不再唯一约束）
  inviteeId     String?          @unique
  invitee       User?            @relation("Invitee", fields: [inviteeId], references: [id])
  /// 邀请状态
  status        InvitationStatus @default(PENDING)
  /// 接受时间
  acceptedAt    DateTime?
  /// 邀请奖励是否已发放
  rewardGranted Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([inviterId, status])
  @@index([code])
  @@index([inviteeId])
}

/// 权益记录（每条记录代表一次可用的付费/免费权益）
model Entitlement {
  id           String            @id @default(cuid())
  /// 关联注册用户（二选一）
  userId       String?
  user         User?             @relation(fields: [userId], references: [id])
  /// 关联游客（二选一）
  guestId      String?
  guest        Guest?            @relation(fields: [guestId], references: [id])
  /// 权益来源
  source       EntitlementSource
  /// 权益状态
  status       EntitlementStatus @default(ACTIVE)
  /// 权益生效日期
  validFrom    DateTime          @default(now())
  /// 权益过期日期
  validUntil   DateTime
  /// 已消费次数（对于按次计费的权益）
  usedCount    Int               @default(0)
  /// 最大可用次数（0 表示无限制，如订阅型）
  maxCount     Int               @default(1)
  /// 关联的订单 ID（如果是付费获得的）
  orderId      String?
  order        Order?            @relation(fields: [orderId], references: [id])
  /// 关联的邀请 ID（如果是邀请奖励）
  invitationId String?
  /// 权益描述
  description  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  matchUnlocks MatchUnlock[]

  @@index([userId, source, status])
  @@index([guestId, source, status])
  @@index([validUntil, status])
  @@index([orderId])
}

/// 比赛级解锁记录：权益针对单场比赛，而不是针对单个 AI 模型。
model MatchUnlock {
  id            String            @id @default(cuid())
  matchId       String
  match         Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?             @relation(fields: [userId], references: [id])
  guestId       String?
  guest         Guest?            @relation(fields: [guestId], references: [id])
  entitlementId String?
  entitlement   Entitlement?      @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  source        EntitlementSource
  createdAt     DateTime          @default(now())

  @@unique([matchId, userId])
  @@unique([matchId, guestId])
  @@index([userId, createdAt])
  @@index([guestId, createdAt])
  @@index([matchId, createdAt])
  @@index([entitlementId])
}

/// 订单（付费购买 World Cup Pass 等）
model Order {
  id              String         @id @default(cuid())
  /// 关联用户
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  /// 支付渠道
  channel         PaymentChannel
  /// 金额（分/cents）
  amountCents     Int
  /// 货币代码（ISO 4217，如 "USD", "CNY"）
  currency        String         @db.VarChar(3)
  /// 订单状态
  status          OrderStatus    @default(CREATED)
  /// 会员等级
  passTier        PassTier?
  /// 会员有效天数
  passDays        Int?
  /// 第三方支付流水号
  externalOrderId String?
  /// 支付时间
  paidAt          DateTime?
  /// 取消时间
  canceledAt      DateTime?
  /// 退款时间
  refundedAt      DateTime?
  /// 失败原因
  failureReason   String?
  /// 订单元数据 JSON（优惠码、折扣信息等）
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  entitlements Entitlement[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([externalOrderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// T4: Post-Match Review / Model Scorecard
// ─────────────────────────────────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  GENERATING
  PUBLISHED
  FAILED
}

/// 单模型赛后复盘
model ModelReview {
  id               String          @id @default(cuid())
  matchId          String
  match            Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  aiModelId        String
  aiModel          AiModel         @relation(fields: [aiModelId], references: [id])
  predictionTaskId String?
  predictionTask   PredictionTask? @relation(fields: [predictionTaskId], references: [id], onDelete: SetNull)
  status           ReviewStatus    @default(PENDING)
  /// 结构化复盘输出 JSON
  structuredOutput Json?
  /// 准确性评估 JSON
  accuracyJson     Json?
  rawOutput        String?
  errorMessage     String?
  publishedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([matchId, aiModelId])
  @@index([matchId, status])
  @@index([aiModelId, createdAt])
}

/// 模型战绩聚合
model ModelScorecard {
  id                 String   @id @default(cuid())
  aiModelId          String
  aiModel            AiModel  @relation(fields: [aiModelId], references: [id], onDelete: Cascade)
  /// 'OVERALL' | 'COMPETITION' | 'RECENT_10'
  scopeType          String   @default("OVERALL")
  /// null for OVERALL/RECENT_10, competitionId for COMPETITION
  scopeId            String?
  totalMatches       Int      @default(0)
  winDrawLossCorrect Int      @default(0)
  scoreExact         Int      @default(0)
  goalRangeHit       Int      @default(0)
  winRate            Float    @default(0)
  /// 近10场结果序列，如 "WWLWDWWLWW"
  recentForm         String?
  lastMatchId        String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([aiModelId, scopeType, scopeId])
  @@index([aiModelId, scopeType])
}

// ─────────────────────────────────────────────────────────────────────────────
// T1-06: Admin User / Audit Log
// ─────────────────────────────────────────────────────────────────────────────

/// 后台管理员身份快照。阶段 1 暂不强制接入完整 RBAC，但所有后台写操作都会归因到该表。
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AdminAuditLog[]

  @@index([status, createdAt])
}

/// 后台审计日志。记录赛事、比赛导入等关键写操作的前后快照，满足阶段 1 可追踪要求。
model AdminAuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  action      String
  targetType  String
  targetId    String?
  beforeJson  Json?
  afterJson   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// T6: Share Attribution & i18n Content Translation
// ─────────────────────────────────────────────────────────────────────────────

/// 分享追踪：记录每次分享行为（小程序码、链接分享等）
model ShareTrack {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  guestId      String?
  guest        Guest?   @relation(fields: [guestId], references: [id])
  matchId      String?
  match        Match?   @relation(fields: [matchId], references: [id])
  /// 分享渠道：WECHAT_MINIPROGRAM | WECHAT_MOMENTS | H5_LINK | COPY_LINK
  channel      String   @default("WECHAT_MINIPROGRAM")
  /// 模板类型：PREDICTION | ROAST | REVIEW | LEADERBOARD
  templateType String   @default("PREDICTION")
  /// 关联邀请码
  inviteCode   String?
  /// 小程序码 scene 值（用于归因）
  sceneValue   String?  @unique
  /// 分享链接
  shareUrl     String?
  /// 小程序码图片 URL
  qrcodeUrl    String?
  /// 浏览次数
  viewCount    Int      @default(0)
  /// 绑定次数（通过此分享注册的用户数）
  bindCount    Int      @default(0)
  /// 额外元数据
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attributions ShareAttribution[]

  @@index([userId, createdAt])
  @@index([matchId])
  @@index([inviteCode])
  @@index([sceneValue])
}

/// 分享归因绑定：新用户通过分享链接注册后的归因记录
model ShareAttribution {
  id            String     @id @default(cuid())
  shareTrackId  String
  shareTrack    ShareTrack @relation(fields: [shareTrackId], references: [id])
  /// 新注册用户
  newUserId     String     @unique
  newUser       User       @relation("AttributedUser", fields: [newUserId], references: [id])
  /// 邀请人
  inviterUserId String?
  inviterUser   User?      @relation("Inviter_Attribution", fields: [inviterUserId], references: [id])
  inviteCode    String?
  sceneValue    String?
  channel       String     @default("WECHAT_MINIPROGRAM")
  registeredAt  DateTime   @default(now())
  rewardGranted Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([shareTrackId])
  @@index([inviterUserId])
}

/// AI 内容翻译表：存储预测、复盘等内容的多语言翻译版本
model ContentTranslation {
  id             String    @id @default(cuid())
  /// 来源类型：PREDICTION_TASK | MODEL_REVIEW | CONSENSUS_SUMMARY
  sourceType     String
  /// 来源 ID
  sourceId       String
  /// 目标语言
  locale         String    @default("en")
  /// 翻译后的结构化 JSON
  structuredJson Json?
  /// 翻译后的原始文本
  rawText        String?
  /// 翻译状态：PENDING | TRANSLATING | COMPLETED | FAILED
  status         String    @default("PENDING")
  /// 翻译提供者
  provider       String?
  /// 错误信息
  errorMessage   String?
  /// 审核状态：AUTO | HUMAN_REVIEWED | REJECTED
  reviewStatus   String    @default("AUTO")
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([sourceType, sourceId, locale])
  @@index([status])
  @@index([sourceType, sourceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// F1: Personality Test & AI PK Light Sharing
// ─────────────────────────────────────────────────────────────────────────────

/// 人格测试活动版本。用于隔离周期性重测、文案池、皮肤和 A/B 配置。
model PersonalityActivity {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  configVersion Int       @default(1)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean   @default(true)
  settings      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  types     PersonalityType[]
  questions PersonalityQuestion[]
  results   PersonalityTestResult[]

  @@index([isActive, startsAt, endsAt])
}

/// 人格类型定义。不同活动下 code 可复用，展示与评分快照由结果表固化。
model PersonalityType {
  id          String              @id @default(cuid())
  activityId  String
  activity    PersonalityActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  code        String
  name        String
  shortName   String?
  description String
  traits      Json?
  indices     Json?
  defaultCta  Json?
  rarity      String?
  themeColor  String?
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  subtitles PersonalitySubtitle[]
  results   PersonalityTestResult[]

  @@unique([activityId, code])
  @@index([activityId, isActive, sortOrder])
}

/// 人格结果副标题池。运营可按人格类型配置多条分享文案。
model PersonalitySubtitle {
  id            String          @id @default(cuid())
  personalityId String
  personality   PersonalityType @relation(fields: [personalityId], references: [id], onDelete: Cascade)
  content       String
  scene         String?
  safetyLevel   String?
  weight        Int             @default(1)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([personalityId, isActive])
}

/// 人格测试题目。评分权重保存在 options JSON 中，由后端校验和计算。
model PersonalityQuestion {
  id         String                  @id @default(cuid())
  activityId String
  activity   PersonalityActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  code       String
  title      String
  subtitle   String?
  type       PersonalityQuestionType @default(SINGLE_CHOICE)
  options    Json
  sortOrder  Int                     @default(0)
  isActive   Boolean                 @default(true)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([activityId, code])
  @@index([activityId, isActive, sortOrder])
}

/// 人格测试结果。保存活动版本、答案、评分、文案、皮肤和分享所需快照。
model PersonalityTestResult {
  id                  String              @id @default(cuid())
  activityId          String
  activity            PersonalityActivity @relation(fields: [activityId], references: [id])
  activityVersion     Int
  userId              String?
  user                User?               @relation(fields: [userId], references: [id])
  guestId             String?
  guest               Guest?              @relation(fields: [guestId], references: [id])
  personalityId       String
  personality         PersonalityType     @relation(fields: [personalityId], references: [id])
  answers             Json
  scoreBreakdown      Json
  selectedSubtitleId  String?
  subtitleVersion     Int                 @default(1)
  selectedSkin        String              @default("CLASSIC_DARK")
  sameCountSnapshot   Int                 @default(0)
  totalCountSnapshot  Int                 @default(0)
  rarityLabelSnapshot String?
  resultSummary       Json?
  inviteCode          String?
  ownerTokenHash      String?
  clientRequestId     String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  events      PersonalityResultEvent[]
  friendVotes PersonalityFriendVote[]

  @@index([activityId, createdAt])
  @@index([userId, createdAt])
  @@index([guestId, createdAt])
  @@index([personalityId, createdAt])
  @@index([clientRequestId])
}

/// 人格结果轻事件。用于结果页互动、分享点击、保存图片和 CTA 指标。
model PersonalityResultEvent {
  id        String                     @id @default(cuid())
  resultId  String
  result    PersonalityTestResult      @relation(fields: [resultId], references: [id], onDelete: Cascade)
  type      PersonalityResultEventType
  metadata  Json?
  createdAt DateTime                   @default(now())

  @@index([resultId, type, createdAt])
  @@index([type, createdAt])
}

/// 好友审判轻事件。支持公开分享页的轻量投票，不要求强登录。
model PersonalityFriendVote {
  id           String                @id @default(cuid())
  resultId     String
  result       PersonalityTestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  sceneValue   String?
  voteType     String
  voterUserId  String?
  voterGuestId String?
  fingerprint  String?
  createdAt    DateTime              @default(now())

  @@index([resultId, voteType, createdAt])
  @@index([sceneValue, createdAt])
}

/// AI PK 站队记录。读取已发布或可展示 AI 共识并保存快照，不在站队时实时调用大模型。
model AiPkRecord {
  id                 String               @id @default(cuid())
  matchId            String
  match              Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?                @relation(fields: [userId], references: [id])
  guestId            String?
  guest              Guest?               @relation(fields: [guestId], references: [id])
  userPick           AiPkPick
  aiPick             AiPkPick
  aiConfidence       Float?
  predictionTaskId   String?
  predictionTask     PredictionTask?      @relation(fields: [predictionTaskId], references: [id])
  aiSummarySnapshot  Json?
  reasonText         String?
  reasonTemplateCode String?
  reasonVersion      Int                  @default(1)
  settlementStatus   AiPkSettlementStatus @default(PENDING)
  settlementSnapshot Json?
  settledAt          DateTime?
  inviteCode         String?
  ownerTokenHash     String?
  clientRequestId    String?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  events AiPkEvent[]

  @@unique([matchId, userId])
  @@unique([matchId, guestId])
  @@index([matchId, createdAt])
  @@index([userId, createdAt])
  @@index([guestId, createdAt])
  @@index([settlementStatus, createdAt])
  @@index([predictionTaskId])
  @@index([clientRequestId])
}

/// AI PK 轻事件。用于保存图片、分享点击、换一句理由和 CTA 指标。
model AiPkEvent {
  id        String        @id @default(cuid())
  recordId  String
  record    AiPkRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type      AiPkEventType
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([recordId, type, createdAt])
  @@index([type, createdAt])
}
