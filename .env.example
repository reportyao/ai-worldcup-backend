# ==== Runtime ====
NODE_ENV=development
API_PORT=3000
WORKER_PORT=3100
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# ==== Database (PostgreSQL, e.g. Supabase or self-hosted) ====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_worldcup?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ai_worldcup?schema=public

# ==== Redis (BullMQ + cache) ====
REDIS_URL=redis://localhost:6379/0

# ==== Auth (JWT for backend session) ====
JWT_SECRET=replace_me_with_a_long_random_string
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# ==== WeChat Mini Program ====
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
WECHAT_MP_TOKEN=
WECHAT_MP_AES_KEY=

# ==== WeChat Pay (V3) ====
WECHAT_PAY_MCHID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=./secrets/wechatpay/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://api.example.com/payments/wechat/notify

# ==== Stripe (国际版预留) ====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PASS_MONTHLY=

# ==== AI Gateway (中转站，可同时配置多模型) ====
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_MODEL_PRIMARY=gpt-4o
AI_MODEL_SECONDARY=claude-3-5-sonnet
AI_MODEL_TERTIARY=gemini-1.5-pro
AI_REQUEST_TIMEOUT_MS=60000

# ==== Football Data Providers ====
FOOTBALL_DATA_ORG_TOKEN=
THESPORTSDB_API_KEY=
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://apiv3.apifootball.com/
# Comma-separated API-Football league ids, e.g. 152,302,207
API_FOOTBALL_LEAGUE_IDS=
DATA_REFRESH_CRON_FIXTURES=0 */6 * * *
DATA_REFRESH_CRON_LIVE=*/2 * * * *

# ==== Storage (对象存储，分享卡片图片等) ====
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=

# ==== AI Translation (T6-05) ====
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=
AI_ALLOW_MOCK=true

# ==== H5/PWA Share (T6-06) ====
H5_BASE_URL=http://localhost:5173

# ==== Prediction Scheduler ====
PREDICTION_SCHEDULER_WINDOW_MINUTES=10
PREDICTION_SCHEDULER_CRON=*/5 * * * *

# ==== Observability ====
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
