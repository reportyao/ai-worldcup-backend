NODE_ENV=development
API_PORT=3000
WORKER_PORT=3100
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8081

# ==== Database (PostgreSQL, e.g. Supabase or self-hosted) ====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_worldcup?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ai_worldcup?schema=public

# ==== Redis (BullMQ + cache) ====
REDIS_URL=redis://localhost:6379/0

# ==== Auth (JWT for backend session) ====
JWT_SECRET=replace_me_with_a_long_random_string
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# ==== Admin Auth ====
ADMIN_EMAIL=admin@ai-worldcup.local
ADMIN_NAME=AI WorldCup Admin
# In production, set ADMIN_PASSWORD or ADMIN_PASSWORD_SHA256, and always set ADMIN_SESSION_SECRET.
ADMIN_PASSWORD=
ADMIN_PASSWORD_SHA256=
ADMIN_SESSION_SECRET=replace_me_with_a_long_random_string
ADMIN_SESSION_TTL_SECONDS=86400

# ==== WeChat Mini Program ====
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
WECHAT_MP_TOKEN=
WECHAT_MP_AES_KEY=

# ==== WeChat Pay (V3) ====
WECHAT_PAY_MCHID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=./secrets/wechatpay/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://api.example.com/payments/wechat/notify

# ==== Stripe (国际版预留) ====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PASS_MONTHLY=

# ==== AI Gateway (中转站，可同时配置多模型) ====
AI_GATEWAY_BASE_URL=
AI_GATEWAY_TIMEOUT_MS=30000
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=
AI_GOOGLE_API_KEY=
AI_GOOGLE_BASE_URL=
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_BASE_URL=
AI_ALLOW_MOCK=true

# ==== Football Data Providers ====
FOOTBALL_DATA_ORG_TOKEN=
THESPORTSDB_API_KEY=
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://apiv3.apifootball.com/
# Comma-separated API-Football league ids, e.g. 152,302,207
API_FOOTBALL_LEAGUE_IDS=
DATA_REFRESH_CRON_FIXTURES=0 */6 * * *
DATA_REFRESH_CRON_LIVE=*/2 * * * *

# ==== Storage (对象存储，分享卡片图片等) ====
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=

# ==== H5/PWA Share (T6-06) ====
H5_BASE_URL=http://localhost:5173

# ==== Prediction Scheduler ====
PREDICTION_SCHEDULER_WINDOW_MINUTES=10
PREDICTION_SCHEDULER_CRON=*/5 * * * *

# ==== Sporttery Auto Sync (竞彩数据自动同步) ====
# 生产默认使用 Asia/Shanghai 时区；Cron 直接按北京时间配置。
# 每天定时同步竞彩赛程：03:00/05:00/10:00/10:10/10:20/10:30/11:00/15:00/24:00
SPORTTERY_DAILY_SYNC_CRON=0 0,3,5,10,11,15 * * *;10,20,30 10 * * *
# 赛果检查与赛程同步同频执行
SPORTTERY_RESULT_CHECK_CRON=0 0,3,5,10,11,15 * * *;10,20,30 10 * * *
# 向后同步天数（默认3天）
SPORTTERY_SYNC_DAYS_AHEAD=3
# 自定义竞彩数据接口 URL（可选，支持 {saleDate} 占位符）
SPORTTERY_FOOTBALL_JC_URL=
# 竞彩接口超时时间（毫秒）
SPORTTERY_TIMEOUT_MS=15000

# ==== Lindy Prediction Auto Trigger ====
# 每天北京时间 14:00 扫描未来 24 小时未开赛比赛，并自动触发 Lindy 预测
LINDY_PREDICTION_CRON=0 14 * * *
LINDY_PREDICTION_TZ=Asia/Shanghai
LINDY_PREDICTION_WINDOW_MINUTES=10
# Lindy webhook/token 可通过管理后台配置；如未配置则读取下列环境变量
LINDY_WEBHOOK_URL=
LINDY_AUTH_TOKEN=
LINDY_DEFAULT_PROMPT=

# ==== Observability ====
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
