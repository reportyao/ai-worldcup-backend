{
  "name": "@ai-worldcup/worker",
  "version": "0.0.1",
  "private": true,
  "description": "BullMQ worker process for AI Worldcup: scheduled prediction generation, data sync, post-match review.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-worldcup/shared": "workspace:*",
    "@prisma/client": "^5.16.1",
    "bullmq": "^5.10.4",
    "ioredis": "5.10.1",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
